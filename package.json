    "@ledgerhq/lumen-design-core": "0.1.30",
    "@ledgerhq/lumen-ui-react": "0.1.61",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
