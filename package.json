    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.21",
    "jsdom": "^30.1.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "postcss": "^8.5.6",
